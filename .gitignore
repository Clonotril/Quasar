## =============================================================================
## Quasar - .gitignore
## =============================================================================
## Covers: Visual Studio, .NET Framework, NuGet, build artifacts, sensitive
## project-specific files, and OS junk.
## =============================================================================

# ==============================================================================
# Build outputs
# ==============================================================================
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# ==============================================================================
# NuGet
# ==============================================================================
*.nupkg
*.snupkg
# Package restore directories
**/packages/*
!**/packages/build/
# NuGet v3 lock file (auto-generated, not needed in repo)
project.lock.json
# NuGet local tool manifest
.config/dotnet-tools.json

# nuget.exe - should not be committed; restore via NuGet package restore
nuget.exe

# ==============================================================================
# Visual Studio user / IDE files
# ==============================================================================
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# VS 2015+ cache/options
.vs/

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JustCode
.JustCode

# Rider
.idea/
*.sln.iml

# NCrunch
_NCrunch_*
.*crunch*.local.xml

# CodeMaid
CodeMaid.config

# ==============================================================================
# Intermediate / compiler files
# ==============================================================================
*_i.c
*_p.c
*_i.h
*.ilk
*.meta
*.obj
*.pch
*.pdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*.log
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# Visual C++ cache
ipch/
*.aps
*.ncb
*.opensdf
*.sdf
*.cachefile

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# ==============================================================================
# Test results
# ==============================================================================
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
*.trx
*.coverage
*.coveragexml

# ==============================================================================
# Build Results of an ATL Project
# ==============================================================================
[Dd]ebugPS/
[Rr]eleasePS/
dlldata.c

# DNX
artifacts/

# ==============================================================================
# Project-specific: Quasar sensitive / operational files
# ==============================================================================

# Server-generated certificate (contains private key for C2 TLS)
*.p12
*.pfx
*.snk
*.cer

# Compiled client stubs (built by the Client Builder at runtime)
client.bin

# Clients folder (server stores captured data here: keylogger logs, screenshots, etc.)
Clients/

# Keylogger logs (if generated during testing)
**/Logs/

# Server settings saved on disk
settings.xml

# ==============================================================================
# Publish / Deploy
# ==============================================================================
publish/
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml
*.publishproj

# ClickOnce
AppPackages/
BundleArtifacts/
Package.StoreAssociation.xml
_pkginfo.txt
*.appx
*.appxbundle
*.appxupload

# Azure
csx/
*.build.csdef
ecf/
rcf/

# ==============================================================================
# Windows / macOS / Linux OS files
# ==============================================================================
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.nfs*

# ==============================================================================
# Other generated / temp
# ==============================================================================
*.cache
!*.cache/
~$*
*.dbmdl
*.dbproj.schemaview
*.publishsettings
node_modules/
orleans.codegen.cs
Generated_Code/

# MightyMoose
*.mm.*
AutoTest.Net/

# Sass
.sass-cache/

# Installshield
[Ee]xpress/

# DocProject
DocProject/buildhelp/
DocProject/Help/*.HxT
DocProject/Help/*.HxC
DocProject/Help/*.hhc
DocProject/Help/*.hhk
DocProject/Help/*.hhp
DocProject/Help/Html2
DocProject/Help/html

# Guidance Automation Toolkit
*.gpState

# TFS
$tf/

# Backup files from VS version upgrades
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm

# SQL Server files
*.mdf
*.ldf
*.ndf

# Business Intelligence
*.rdl.data
*.bim.layout
*.bim_*.settings

# Fakes
FakesAssemblies/

# Node.js Tools for VS
.ntvs_analysis.dat

# VS 6
*.plg
*.opt

# Chutzpah
_Chutzpah*

# DotCover
*.dotCover

# TeamCity
_TeamCity*

# Web workbench
.sass-cache/

# Telerik
*.lsaprototype

# ServiceFabric
*.sfpkg

# LightSwitch generated files
GeneratedArtifacts/
_Pvt_Extensions/
ModelManifest.xml

# MiniProfiler
App_Data/*.MDF
App_Data/*.LDF

# BenchmarkDotNet
BenchmarkDotNet.Artifacts/

# Paket
.paket/paket.exe
paket-files/

# CAKE
tools/**
!tools/packages.config

# ==============================================================================
# AI assistant outputs (Claude, Copilot, etc.)
# ==============================================================================
.claude/
.claude_output/
.cursorrules
.cursorignore
.aider*
.copilot/
.github/copilot/
